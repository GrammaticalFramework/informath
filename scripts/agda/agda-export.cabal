cabal-version:      2.4
name:               agda-export
version:            0.1.0.0
synopsis:           An Agda backend writing Agda's internal syntax as JSON, for Informath
build-type:         Simple

executable agda-export
    main-is:          Main.hs
    build-depends:    base, Agda ==2.8.0, aeson, bytestring, containers, text, directory, filepath, deepseq
    default-language: Haskell2010
    ghc-options:      -O0
