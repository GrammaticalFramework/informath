Set : Type.
Elem : Set -> Type.

Prop : Type.
Proof : Prop -> Type.

forall : (A : Set) -> (B : ((x : Elem A) -> Prop)) -> Prop.

Structure : Type.

equal : (A : Set) -> Elem A -> Elem A -> Prop.
refl : (A : Set) -> (a : Elem A) -> Proof (equal A a a).

Oper : Set -> Type.
appOper : (A : Set) -> ({|*|} : Oper A) -> (x : Elem A) -> (y : Elem A) -> Elem A.

def associative : (A : Set) -> ({|*|} : Oper A) -> Prop :=
  A => {|*|} => 
    forall A (x => forall A (y => forall A (z =>
        equal A (appOper A {|*|} x (appOper A {|*|} y z)) (appOper A {|*|} (appOper A {|*|} x y) z)))).

def commutative : (A : Set) -> Oper A -> Prop :=
  A => {|*|} => 
    forall A (x => forall A (y => 
        equal A (appOper A {|*|} x y) (appOper A {|*|} y x))).

Magma : (S : Set) -> ({|*|} : Oper S) -> Structure.

Semigroup :
  (S : Set) -> ({|*|} : Oper S) ->
      (assoc : Proof (associative S {|*|})) ->
         Structure.

Monoid :
  (S : Set) -> ({|*|} : Oper S) ->
    (assoc : Proof (associative S {|*|})) ->
      (e : Elem S) ->
        Proof (forall S (x => equal S (appOper S {|*|} x e) x)) ->
          Proof (forall S (x => equal S (appOper S {|*|} e x) x)) ->
            Structure.

Group :
  (S : Set) -> ({|*|} : Oper S) ->
    (assoc : Proof (associative S {|*|})) ->
      (e : Elem S) ->
        Proof (forall S (x => equal S (appOper S {|*|} x e) x)) ->
          Proof (forall S (x => equal S (appOper S {|*|} e x) x)) ->
	    (inv : (Elem S -> Elem S)) ->
	      Proof (forall S (x => equal S (appOper S {|*|} x (inv x)) e)) ->
	        Proof (forall S (x => equal S (appOper S {|*|} (inv x) x) e)) ->
                  Structure.

AbelianGroup :
  (S : Set) -> ({|*|} : Oper S) ->
    (assoc : Proof (associative S {|*|})) ->
      (commut : Proof (commutative S {|*|})) ->
        (e : Elem S) ->
          Proof (forall S (x => equal S (appOper S {|*|} x e) x)) ->
	    (inv : (Elem S -> Elem S)) ->
	      Proof (forall S (x => equal S (appOper S {|*|} x (inv x)) e)) ->
                Structure.


(; The same structures as a series of extensions: each takes its parent
   structure M and adds its new fields only, written with the parent's
   selectors. The selectors are made by scripts/structure_selectors.py,
   which gives an extension also the selectors of its parent's fields
   (S_Semigroup' (Semigroup' M assoc) --> S_Magma M); as the extensions use
   the selectors, the file is checked with them, by the same script. ;)

Semigroup' :
  (M : Structure) ->
    (assoc : Proof (associative (S_Magma M) (star_Magma M))) ->
      Structure.

Monoid' :
  (M : Structure) ->
    (e : Elem (S_Semigroup' M)) ->
      Proof (forall (S_Semigroup' M) (x =>
        equal (S_Semigroup' M) (appOper (S_Semigroup' M) (star_Semigroup' M) x e) x)) ->
        Proof (forall (S_Semigroup' M) (x =>
          equal (S_Semigroup' M) (appOper (S_Semigroup' M) (star_Semigroup' M) e x) x)) ->
          Structure.

Group' :
  (M : Structure) ->
    (inv : (Elem (S_Monoid' M) -> Elem (S_Monoid' M))) ->
      Proof (forall (S_Monoid' M) (x =>
        equal (S_Monoid' M) (appOper (S_Monoid' M) (star_Monoid' M) x (inv x)) (e_Monoid' M))) ->
        Proof (forall (S_Monoid' M) (x =>
          equal (S_Monoid' M) (appOper (S_Monoid' M) (star_Monoid' M) (inv x) x) (e_Monoid' M))) ->
          Structure.

AbelianGroup' :
  (M : Structure) ->
    (commut : Proof (commutative (S_Group' M) (star_Group' M))) ->
      Structure.
