# symbol table for test/godement_syntax.tex, the constructions of grammars/GodementSyntax.gf
# kinds and predicates come in pairs, because GodementSemantics maps "x is a K" to the predicate

Group : "group"
isGroup : "X is a group"
Ring : "ring"
isRing : "X is a ring"
Homomorphism : "homomorphism"
isHomomorphism : "X is a homomorphism"
subgroup : "subgroup of X"
isSubgroup : "X is a subgroup of Y"
divisor : "divisor of X"
isDivisor : "X is a divisor of Y"
leftReflection : "left reflection of X"
isLeftReflection : "X is a left reflection of Y"

isCommutative : "X is commutative"
isAbelian : "X is abelian"
isInvertible : "X is invertible"
isReflexible : "X is reflexible"
isNormal : "X is normal"
isInvariant : "X is invariant"
isInjective : "X is injective"
isSurjective : "X is surjective"
isBijective : "X is bijective"
isFinite : "X is finite"
isUnit : "X is a unit"
isIsomorphic : "X and Y are isomorphic"
isDivisibleBy : "X is divisible by Y"
contains : "X contains Y"

characteristic : "the characteristic of X"
order : "the order of X"
determinant : "the determinant of X"
kernel : "the kernel of X"
Isomorphism : "isomorphism"
isIsomorphism : "X is an isomorphism"
subset : "subset of X"
isSubset : "X is a subset of Y"
Element : "element"
