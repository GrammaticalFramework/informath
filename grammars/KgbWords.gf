abstract KgbWords = Categories ** {
-- words of the informalization of von Plato's article on Gödel's formalization of
-- epsilon_0 in the system of finite types (~/claude/kgb/informath)
fun proof_of_well_ordering_Noun : Noun ;    -- phi is a proof of well-ordering for alpha
fun accompanying_functional_Noun : Noun ;   -- phi_1 is an accompanying functional for f_1
fun proof_functional_Noun : Noun ;          -- the proof functionals of type n
fun inflationary_Adj : Adj ;                -- F(g) >= g
}
