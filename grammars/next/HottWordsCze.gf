concrete HottWordsCze of HottWords = CategoriesCze **

open UtilitiesCze, ParadigmsCze in {

lin homotopic_Adj = mkAdj (mkA "homotopický") ;
lin reflexivity_Noun = mkNoun (mkN "reflexivita" "reflexivity" feminine) ;

-- words of the Mathlib informalization
lin coprime_Adj = mkAdj (mkA "nesoudělný") ;
lin factor_Noun = mkNoun (mkN "faktor" "faktoru" mascInanimate) ;
lin predecessor_Noun = mkNoun (mkN "předchůdce" "předchůdce" mascAnimate) ;
lin preorder_Noun = mkNoun (mkN "předuspořádání" "předuspořádání" neuter) ;
lin procedure_Noun = mkNoun (mkN "procedura" "procedury" feminine) ;
lin supremum_Noun = mkNoun (mkN "supremum" "suprema" neuter) ;
lin nonempty_Adj = mkAdj (mkA "neprázdný") ;
lin subtype_Noun = mkNoun (mkN "podtyp" "podtypu" mascInanimate) ;
lin bijective_Adj = mkAdj (mkA "bijektivní") ;
lin count_Noun = mkNoun (mkN "počet" "počtu" mascInanimate) ;
lin segment_Noun = mkNoun (mkN "úsek" "úseku" mascInanimate) ;
lin coproduct_Noun = mkNoun (mkN "koprodukt" "koproduktu" mascInanimate) ;
lin bottom_Noun = mkNoun (mkN "dno" "dna" neuter) ;
lin swap_Noun = mkNoun (mkN "záměna" "záměny" feminine) ;
lin top_Noun = mkNoun (mkN "vrchol" "vrcholu" mascInanimate) ;
lin fact_Noun = mkNoun (mkN "fakt" "faktu" mascInanimate) ;
lin lift_Noun = mkNoun (mkN "zdvih" "zdvihu" mascInanimate) ;
lin respect_Noun = mkNoun (mkN "ohled" "ohledu" mascInanimate) ;

}
