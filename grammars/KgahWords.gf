abstract KgahWords = Categories ** {
-- words of the informalization of von Plato's Coq files on Gödel's independence proofs
-- (~/claude/kgah/informath): the objects of types r, s, c of the model, forcing
fun real_object_Noun : Noun ;               -- a real (an object of type r): "real", not "real number" (real_Noun)
fun set_of_reals_Noun : Noun ;              -- an object of type s
fun relation_between_sets_of_reals_and_reals_Noun : Noun ;  -- an object of type c
fun force_Verb : Verb ;                     -- k forces A
fun closed_downwards_Adj : Adj ;            -- a set of conditions closed downwards
}
