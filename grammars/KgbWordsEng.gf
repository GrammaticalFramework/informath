concrete KgbWordsEng of KgbWords = CategoriesEng **
open UtilitiesEng, SyntaxEng, ParadigmsEng, (G = GrammarEng) in {
lin proof_of_well_ordering_Noun =
  mkCN (mkCN (mkN "proof")) (SyntaxEng.mkAdv possess_Prep (mkNP (mkN "well-ordering"))) ;
lin accompanying_functional_Noun = mkCN (mkA "accompanying") (mkN "functional") ;
lin proof_functional_Noun = mkCN (mkN "proof" (mkN "functional")) ;
lin inflationary_Adj = mkAP (mkA "inflationary") ;
}
